# =============================================================================
#  AME & VIE — Variables d'environnement
#  Copiez ce fichier en « .env.local » pour le développement (vercel dev)
#  et ajoutez les MÊMES variables dans Vercel → Settings → Environment Variables.
#
#  ⚠️ AUCUNE de ces variables ne doit commencer par VITE_ :
#     elles restent côté serveur (fonctions /api) et ne sont jamais
#     envoyées au navigateur.
# =============================================================================

# Supabase → Project Settings → API → Project URL
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Supabase → Project Settings → API → service_role (SECRET : jamais dans le front-end)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service_role..."

# Supabase → Project Settings → API → anon public
# (utilisée uniquement côté serveur pour vérifier l'email / mot de passe administrateur)
SUPABASE_ANON_KEY="eyJhbGciOi...anon..."

# Secret de signature des sessions (HMAC-SHA256), 32 caractères minimum.
# Générez-le avec :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PDG_AUTH_SECRET="remplacez-moi-par-une-longue-chaine-aleatoire-de-48-caracteres"
